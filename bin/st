#!/bin/bash

esc=$(printf '\033')

cd ~/projects

for d in `ls -d */.git`; do
    cd $d/..
    WD=$(basename $(pwd))
    # Prefix the last path on each porcelain line with the repo dir (BSD/GNU awk, no gsed)
    git status --porcelain | awk -v wd="$WD" '{ if (match($0, / [^[:space:]]+$/)) $0 = substr($0, 1, RSTART) wd "/" substr($0, RSTART + 1); print }'
    cd ..
done
