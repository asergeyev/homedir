#!/usr/bin/env python3
# decode STRING — print STRING base64-decoded, then URL-unquoted (+ as a space).

import base64
import sys
import urllib.parse as ul

if len(sys.argv) != 2:
    sys.exit("usage: decode STRING")
try:
    print(ul.unquote_plus(base64.b64decode(sys.argv[1]).decode("utf-8")))
except Exception as e:
    sys.exit(f"Invalid input ({e})")
