#!/usr/bin/env bash
# homedir-prune — periodic cleanup to keep caches, old agent binaries, and runtime versions lean.
set -euo pipefail

echo "==> Pruning mise unused versions..."
command -v mise >/dev/null 2>&1 && mise prune --yes || true

echo "==> Pruning uv cache..."
# A running `uv run` (Claude Code's MCP servers) holds the cache: prune waits until it exits, and --force would delete
# the environment it runs from. So give up after 10 s
if command -v uv >/dev/null 2>&1 && ! UV_LOCK_TIMEOUT=10 uv cache prune --ci; then
  echo "    Skipped: re-run once nothing runs uv (quit Claude Code, whose MCP servers do)"
fi

echo "==> Cleaning Go build & test caches..."
command -v go >/dev/null 2>&1 && go clean -cache -testcache || true

echo "==> Pruning old Claude Code binaries (keeping 2 newest)..."
if [ -d "$HOME/.local/share/claude/versions" ]; then
  ls -t "$HOME/.local/share/claude/versions" | tail -n +3 | while IFS= read -r old; do
    rm -f "$HOME/.local/share/claude/versions/$old"
  done
fi

echo "==> Pruning Docker (if OrbStack or Lima docker is running)..."
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  docker system prune -f
fi

# The Linux machines and the disk each uses. `orbctl status` never starts OrbStack, `orbctl list` may
if command -v orbctl >/dev/null 2>&1; then
  if orbctl status >/dev/null 2>&1; then
    echo "==> OrbStack machines:"
    orbctl list | sed 's/^/    /' || true
  else
    echo "==> OrbStack isn't running: not listing its machines."
  fi
fi

if command -v limactl >/dev/null 2>&1; then
  # limactl's DISK column is the disk's size limit: the blocks the sparse disk holds are its use
  echo "==> Lima machines:"
  limactl list --json | jq -r '.name + " " + .status + " " + .dir' | while read -r name status dir; do
    size=$(du -sk "$dir/diffdisk" 2>/dev/null | awk '{ printf "%.1f GB", $1 * 1024 / 1e9 }')
    printf '    %-12s %-8s %s\n' "$name" "$status" "$size"
  done || true
fi

echo "==> Done."
