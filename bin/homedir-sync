#!/usr/bin/env bash
# homedir-sync — Show how the tool configs homedir copies into ~ (the `sync` lines of conf/configs.txt) compare with
# this checkout. The copy each had when the two last matched (~/.local/state/homedir/base/) shows which side changed:
# yours, homedir's (pulled from another Mac) or both. Copying either way and committing conf/ are yours to do.
set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") [--status | --diff [FILE]]
  (none), --status  show how each config compares with homedir's
  --diff [FILE]     the same, with the differences of every config or of FILE (~/.zshrc or conf/zsh/.zshrc);
                    whitespace is ignored unless it is all that differs
Copy either way yourself; the next run then remembers that the two match.
The seed configs aren't compared: conf/review-configs.md has Claude Code review every config.
EOF
}

DIFF=0 ONLY=
while [ $# -gt 0 ]; do
  case "$1" in
    --status) shift ;;
    --diff)
      DIFF=1
      shift
      case "${1:-}" in '' | -*) ;; *) ONLY=$1; shift ;; esac
      ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

SRC="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BASE="$HOME/.local/state/homedir/base"
# FILE as configs.txt has it: a path under ~ or in this checkout
case "$ONLY" in
  "$SRC"/*) ONLY=${ONLY#"$SRC"/} ;;
  "$HOME"/*) ONLY=${ONLY#"$HOME"/} ;;
  '~/'*) ONLY=${ONLY#'~/'} ;;
  ./*) ONLY=${ONLY#./} ;;
esac

# set_base FILE: remember FILE as the last-synced copy of the current config
set_base() {
  (umask 077 && mkdir -p "$(dirname "$base")" && cp "$1" "$base")
}

# udiff OLD NEW OLD_LABEL NEW_LABEL: diff -u ignoring whitespace, or in full when whitespace is all that differs
udiff() {
  if diff -q -w "$1" "$2" >/dev/null 2>&1; then
    echo "### Only whitespace differs"
    diff -u --label "$3" --label "$4" "$1" "$2" || true
  else
    diff -u -w --label "$3" --label "$4" "$1" "$2" || true
  fi
}

# show_diff: the differences of the current config, homedir's side first
show_diff() {
  if [ "$state" = "changed in both" ]; then
    echo "### Yours since the last sync"
    udiff "$base" "$mine" "last sync" "yours: ~/$dst"
    echo "### homedir's since the last sync"
    udiff "$base" "$def" "last sync" "homedir: $rel"
  else
    udiff "$def" "$mine" "homedir: $rel" "yours: ~/$dst"
  fi
  echo
}

FOUND=0 DIFFERS=0
while read -r mode _ rel dst || [ -n "${mode:-}" ]; do
  [ "$mode" = sync ] || continue
  if [ -n "$ONLY" ] && [ "$ONLY" != "$dst" ] && [ "$ONLY" != "$rel" ]; then continue; fi
  FOUND=1
  def="$SRC/$rel" mine="$HOME/$dst" base="$BASE/$dst"
  if [ ! -f "$def" ]; then
    state="not in homedir: skipped"
  elif [ ! -e "$mine" ]; then
    state="not here"
  elif cmp -s "$mine" "$def"; then
    state=same
    if ! cmp -s "$mine" "$base" 2>/dev/null; then set_base "$mine"; fi
  elif [ ! -f "$base" ]; then
    state="differs (no earlier sync to tell which side changed)"
  elif cmp -s "$def" "$base"; then
    state="changed here"
  elif cmp -s "$mine" "$base"; then
    state="changed in homedir"
  else
    state="changed in both"
  fi
  printf '    %-56s %s\n' "~/$dst" "$state"
  case "$state" in
    differs* | changed*)
      DIFFERS=1
      if [ "$DIFF" = 1 ]; then show_diff; fi
      ;;
  esac
done <"$SRC/conf/configs.txt"

if [ -n "$ONLY" ] && [ "$FOUND" = 0 ]; then
  echo "Not a sync config: $ONLY (the sync lines of $SRC/conf/configs.txt list them)" >&2
  exit 2
fi
if [ "$DIFFERS" = 1 ]; then
  if [ "$DIFF" = 0 ]; then echo "The differences: $(basename "$0") --diff [FILE]"; fi
  echo "Copy either way yourself, and commit conf/ on a branch; the next run remembers that the two match."
fi
