[user]
	name = Alex Sergeyev
	email = abc@alexsergeyev.com

[push]
	default = current

[pull]
	default = current
	rebase = true

[alias]
	b = branch --sort=-committerdate
	bD = branch -d
	bM = branch -m
	bg = ! git branch --sort=-committerdate | grep
	c = checkout
	main-branch = !git symbolic-ref refs/remotes/origin/HEAD | cut -d'/' -f4
	remotesh = remote set-head origin --auto
	main = "!git fetch --prune && git checkout -m $(git main-branch) && git remote set-head origin --auto && git upm $@"
	upm = "!git pull --rebase --autostash origin $(git main-branch) $@"
	rebasem = "!git rebase -i --autostash origin/$(git main-branch) $@"
	cb = "!f() { git checkout -b \"$(git config user.email | cut -d@ -f1)-$(date +%Y%m%d)-$(echo $@ | tr ' ' '-' | tr [:upper:] [:lower:])\"; }; f"
	master = main
	fetch = fetch --prune
	l = log --oneline --graph --decorate
	push-force = push --force-with-lease
	s = st
	status = st
	statys = st
	diff = diff -w

[color "branch"]
	current = green
	local = normal
	remote = cyan
	worktree = magenta

[color "status"]
	added = yellow
	changed = red
	untracked = cyan

[core]
	excludesFile = ~/.config/git/ignore
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[blame]
	ignoreRevsFile = ~/.config/git/ignore-revs

[merge]
	conflictstyle = zdiff3

[init]
	defaultBranch = main

# Work settings (a work [user], SSH rewrites for private orgs) live in config-work: a commented template in homedir,
# your own copy from the backup. Included last, so what it sets wins; a ~ path, so it still resolves when git reads
# this file through a ~/.gitconfig symlink.
[include]
	path = ~/.config/git/config-work
